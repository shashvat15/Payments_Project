{
	"info": {
		"_postman_id": "a1b2c3d4-payflow-phase2b-saga",
		"name": "PayFlow - Distributed Payment System (Phase 2B - Saga Orchestration)",
		"description": "API collection for testing PayFlow Saga Orchestration across Order, Inventory, Payment, and Saga Orchestrator services.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Order Service (Port 8081)",
			"item": [
				{
					"name": "1. Create Order - Happy Path (Saga Success)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"customerId\": 42,\n  \"amount\": 5000.00,\n  \"productId\": 1001,\n  \"quantity\": 1\n}"
						},
						"url": {
							"raw": "http://localhost:8081/api/orders",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8081",
							"path": ["api", "orders"]
						},
						"description": "Happy Path: Order created -> Saga Orchestrator reserves inventory in inventory-service -> processes payment in payment-service -> confirms order in order-service. Status transitions from PAYMENT_PENDING to PAID."
					}
				},
				{
					"name": "2. Create Order - Simulate Payment Failure & Inventory Compensation",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"customerId\": 42,\n  \"amount\": 5000.00,\n  \"productId\": 1001,\n  \"quantity\": 1,\n  \"simulatePaymentFailure\": true\n}"
						},
						"url": {
							"raw": "http://localhost:8081/api/orders",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8081",
							"path": ["api", "orders"]
						},
						"description": "Compensation Path: Inventory is reserved -> Payment fails -> Saga Orchestrator executes COMPENSATION by issuing ReleaseInventory to inventory-service -> cancels order in order-service (status CANCELLED)."
					}
				},
				{
					"name": "3. Create Order - Simulate Inventory Reservation Failure",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"customerId\": 42,\n  \"amount\": 5000.00,\n  \"productId\": 1002,\n  \"quantity\": 1\n}"
						},
						"url": {
							"raw": "http://localhost:8081/api/orders",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8081",
							"path": ["api", "orders"]
						},
						"description": "Product 1002 has 0 available units. Inventory reservation fails immediately -> Saga Orchestrator cancels order without needing compensation."
					}
				},
				{
					"name": "4. Create Order - Simulate Dual-Write Failure",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"customerId\": 42,\n  \"amount\": 5000.00,\n  \"simulateKafkaPublishFailure\": true\n}"
						},
						"url": {
							"raw": "http://localhost:8081/api/orders",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8081",
							"path": ["api", "orders"]
						},
						"description": "Demonstrates the Dual-Write Problem: Order is committed to order_db, but Kafka event publishing fails."
					}
				},
				{
					"name": "Get Order By ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:8081/api/orders/1",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8081",
							"path": ["api", "orders", "1"]
						}
					}
				},
				{
